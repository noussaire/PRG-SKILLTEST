{
  "name": "skillquest-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:vercel": "npm run db:generate && npm run build",
    "qualify:build": "node scripts/qualify-build.mjs",
    "qualify:pooling": "node scripts/qualify-pooling.mjs",
    "qualify:pdf": "node scripts/qualify-pdf.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --import tsx prisma/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:deploy": "prisma migrate deploy",
    "sessions:cleanup": "node --import tsx src/scripts/cleanup-sessions.ts",
    "counters:cleanup": "node --import tsx src/scripts/cleanup-email-counters.ts",
    "admin:password": "node --import tsx src/scripts/reset-admin-password.ts",
    "pdf:install": "playwright install chromium"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@sparticuz/chromium": "153.0.0",
    "@upstash/qstash": "2.12.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "^8.0.0",
    "playwright": "^1.62.1",
    "playwright-core-serverless": "npm:playwright-core@1.63.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
