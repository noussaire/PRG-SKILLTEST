# Copier vers backend/.env. Ne jamais partager ce fichier une fois renseigné.
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLER-HOST/skillquest?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/skillquest?sslmode=require"
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOIN_CODE_PEPPER="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
CORS_ORIGIN="http://localhost:3000"
# false par défaut. En cas de reverse proxy, renseigner uniquement ses adresses/réseaux fiables.
TRUST_PROXY=false
# Seed volontaire réservé au développement ; ne pas l'exécuter sur une base réelle existante.
ALLOW_DEMO_SEED=false
ADMIN_EMAIL="votre-adresse@example.com"
ADMIN_PASSWORD="REPLACE_WITH_YOUR_OWN_LONG_PASSWORD"
SEED_SESSION_CODE="REPLACE_WITH_YOUR_PRIVATE_CODE"

# Synthèse IA facultative après les 31 questions : offre Free Groq, clé côté serveur.
# Sans clé, les questions et le bilan automatique fonctionnent. Ne pas activer la facturation.
# Guide : docs/IA_GRATUITE.md
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
# Limite partagée d'appels tentés par jour ; les quotas Groq s'appliquent aussi.
AI_DAILY_REQUEST_LIMIT=400

# Envoi transactionnel du rapport complet après la synthèse IA (Brevo).
# Clé privée côté serveur uniquement ; expéditeur à vérifier dans le compte Brevo.
# Guide : docs/BREVO.md
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="SkillQuest · Chabab Connect"
# URL HTTPS du PNG blanc dans la bibliothèque Brevo (jamais localhost).
REPORT_EMAIL_LOGO_URL=""
# Facultatif : chemin du navigateur installé pour générer les PDF.
# Sur Linux : installer Chromium avec npm run pdf:install -w backend.
REPORT_CHROMIUM_EXECUTABLE=""
